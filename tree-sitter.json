{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "klang",
      "camelcase": "KLang",
      "title": "klang",
      "scope": "source.klang",
      "file-types": [
        "klang"
      ],
      "injection-regex": "^klang$",
      "class-name": "TreeSitterKlang"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "\"A tree-sitter grammar for the custom upd dcs language called klang\"",
    "authors": [
      {
        "name": "\"Jan Michael Tauli\"",
        "email": "\"jm1michael2@gmail.com\"",
        "url": ""
      }
    ],
    "links": {
      "repository": "git@github.com:chaelimnaj-ui/klang_treesitter.git",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}