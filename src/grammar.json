    "id": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[a-z]"
        },
        {
          "type": "PATTERN",
          "value": "[a-zA-Z0-9_$]+"
        }
      ]
    },
    "upper_id": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[A-Z]"
